{
  "name": "@meetmaze/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/core/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "db:migrate": "knex migrate:latest --knexfile src/core/knexfile.ts",
    "db:seed": "knex seed:run --knexfile src/core/knexfile.ts",
    "db:reset": "knex migrate:rollback --all --knexfile src/core/knexfile.ts && knex migrate:latest --knexfile src/core/knexfile.ts && knex seed:run --knexfile src/core/knexfile.ts"
  },
  "dependencies": {
    "@meetmaze/shared": "*",
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "knex": "^3.1.0",
    "mysql2": "^3.9.7",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "express-rate-limit": "^7.2.0",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.1.0",
    "qrcode": "^1.5.3",
    "nanoid": "^5.0.7",
    "uuid": "^9.0.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/uuid": "^9.0.8",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
