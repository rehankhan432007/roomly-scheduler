{
  "name": "meetmaze",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run gen && npm -w apps/api run dev",
    "dev:web": "npm run gen && npm -w apps/web run dev",
    "build": "npm run gen && npm -w packages/shared run build && npm -w apps/api run build && npm -w apps/web run build",
    "typecheck": "npm run gen && tsc -b",
    "lint": "echo 'lint pass'",
    "test": "npm -w apps/api run test",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "npm -w apps/api run db:migrate",
    "db:seed": "npm -w apps/api run db:seed",
    "db:reset": "npm -w apps/api run db:reset",
    "gen": "node scripts/gen-registry.mjs",
    "predev": "npm run gen",
    "prebuild": "npm run gen",
    "pretest": "npm run gen",
    "pretypecheck": "npm run gen",
    "part:export": "node scripts/export-part.mjs",
    "part:import": "node scripts/import-part.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
